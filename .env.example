# NepalEstates - Environment Variables

# App Configuration
VITE_BASE44_APP_ID=your_app_id_here
VITE_BASE44_FUNCTIONS_VERSION=v1
VITE_BASE44_APP_BASE_URL=https://your-domain.com

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# Analytics (Optional)
VITE_ANALYTICS_ID=your_analytics_id

# Feature Flags
VITE_ENABLE_BETA_FEATURES=false

# Image Validation — AI-powered image analysis via Claude claude-haiku
# Get your key at: https://console.anthropic.com/
# Without this key, the system runs in heuristic-only mode (no AI scan button).
VITE_ANTHROPIC_API_KEY=
