# MongoDB Connection - LOCAL DEVELOPMENT
# For production on Vercel, use a cloud MongoDB service (MongoDB Atlas, etc.)
# Production example: mongodb+srv://username:password@cluster.mongodb.net/real-estate
DB_URI=mongodb://localhost:27017/real-estate

# JWT Secrets - CHANGE THESE IN PRODUCTION!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production_67890

# Server Configuration
NODE_ENV=development
PORT=3000

# Frontend URL (for CORS)
# Development: http://localhost:5173
# Production on Vercel: https://your-project.vercel.app
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Vercel Production Notes:
# 1. Set DB_URI to MongoDB Atlas connection string
# 2. Generate new JWT_SECRET and JWT_REFRESH_SECRET for production
# 3. Update FRONTEND_URL to your Vercel deployment URL
# 4. Add these as environment variables in Vercel project settings

